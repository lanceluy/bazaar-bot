# ---- Google Places API ----
# Create a key in Google Cloud Console with "Places API (New)" enabled.
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# ---- Gmail sending ----
# Use a Gmail App Password (requires 2FA enabled on the account), NOT your normal password.
# https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
# Display name shown as the sender
SENDER_NAME=Your Bazaar Team

# ---- Sending behaviour ----
# Seconds to wait between each send (throttle). Keep daily total well under ~500.
SEND_THROTTLE_SECONDS=8

# ---- Event details (used in the invitation template) ----
EVENT_NAME=Riverside Spring Bazaar
EVENT_DATE=Saturday, May 16, 2026
EVENT_LOCATION=Riverside Community Hall, 12 Market Street
EVENT_DETAILS_URL=https://example.com/bazaar
ORGANIZER_NAME=Jane Organizer

# ---- Compliance footer (CAN-SPAM requires a real physical mailing address) ----
SENDER_POSTAL_ADDRESS=Bazaar Org, 12 Market Street, Riverside, CA 90000

# ---- Flask ----
FLASK_SECRET_KEY=change-me-to-something-random
